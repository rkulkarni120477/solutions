# Defaults run a clearly labeled local demo. Copy to .env at repository root.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./.data/workspace.db
STORAGE_BACKEND=local
STORAGE_PATH=.data/objects
AUTH_MODE=demo
# Local single-user workspace: AUTH_MODE=local, set password, enable auto sign-in.
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=
LOCAL_AUTO_LOGIN=false
LLM_PROVIDER=demo
LLM_MODEL=
PUBLIC_URL=http://localhost:5173
SESSION_SECRET=development-only-change-this-before-deployment
SECURE_COOKIES=false
EMBEDDED_WORKER=true
RENDERER_URL=http://localhost:3001
RENDERER_SECRET=development-renderer-secret
# Live providers: openai | azure | bedrock. Model/deployment must be supplied.
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AWS_REGION=us-east-1
# Use the AWS credential chain for Bedrock/S3 (task roles in AWS).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
MAX_INPUT_TOKENS=24000
MAX_OUTPUT_TOKENS=10000
LLM_TIMEOUT=120
UPLOAD_MAX_MB=15
JOBS_PER_HOUR=30
RETENTION_DAYS=90
DOWNLOAD_TTL=300
OCR_ENABLED=false
# OIDC, including Entra ID: use tenant-specific discovery URL.
OIDC_METADATA_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# PostgreSQL + S3 are selected by Compose overrides.
S3_ENDPOINT=
S3_BUCKET=workspace
S3_SSE=AES256
# Local Compose only; replace these before any shared deployment.
POSTGRES_PASSWORD=local-workspace-only
MINIO_ROOT_USER=workspace-local
MINIO_ROOT_PASSWORD=workspace-local-password
